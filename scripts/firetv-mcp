#!/usr/bin/env python3
"""MCP server (stdio, standard library only) that lets an AI assistant control a Fire TV.

Every tool runs the `firetv` command next to this file, which talks to the TV over ADB.
Your assistant starts it directly, or over ssh from another machine:
    ssh pi@homelab '~/.local/bin/firetv-mcp'
"""
import json
import os
import subprocess
import sys

FIRETV = os.path.join(os.path.dirname(os.path.abspath(__file__)), "firetv")

BUTTONS = ["home", "back", "up", "down", "left", "right", "ok", "menu",
           "play", "pause", "playpause", "next", "prev"]
APPS = ["netflix", "youtube", "prime", "twitch", "music", "shopping", "jellyfin", "smarttube", "home"]
SETTINGS = ["network", "device", "apps", "controllers", "display", "preferences", "accessibility", "equipment",
            "livetv", "notifications", "alexa", "sleeptimer", "help"]

TOOLS = [
    {
        "name": "tv_status",
        "description": "Check the Fire TV: whether it is reachable, whether the screen is awake, "
                       "which app is on screen, and the volume.",
        "inputSchema": {"type": "object", "properties": {}},
        "annotations": {"title": "Fire TV status", "readOnlyHint": True},
    },
    {
        "name": "tv_open_app",
        "description": "Open an app on the Fire TV. 'jellyfin' is your own movies and shows from "
                       "the homelab; 'smarttube' is YouTube without ads. 'home' goes back to the home screen.",
        "inputSchema": {
            "type": "object",
            "properties": {"app": {"type": "string", "enum": APPS}},
            "required": ["app"],
        },
        "annotations": {"title": "Open an app", "readOnlyHint": False, "destructiveHint": False},
    },
    {
        "name": "tv_press",
        "description": "Press a button on the Fire TV remote: home, back, arrows, ok, menu, "
                       "or playback (play, pause, playpause, next, prev).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "button": {"type": "string", "enum": BUTTONS},
                "times": {"type": "integer", "minimum": 1, "maximum": 10, "default": 1},
            },
            "required": ["button"],
        },
        "annotations": {"title": "Press a remote button", "readOnlyHint": False, "destructiveHint": False},
    },
    {
        "name": "tv_volume",
        "description": "Turn the Fire TV volume up or down by a number of steps, or toggle mute.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "action": {"type": "string", "enum": ["up", "down", "mute"]},
                "steps": {"type": "integer", "minimum": 1, "maximum": 10, "default": 1},
            },
            "required": ["action"],
        },
        "annotations": {"title": "Change the volume", "readOnlyHint": False, "destructiveHint": False},
    },
    {
        "name": "tv_search",
        "description": "Search for a movie, show or video on the Fire TV and show the results on screen. "
                       "Netflix for movies and shows, YouTube for videos. The person then picks a result with the "
                       "remote (or ask to press arrows and ok); Netflix may show its profile picker first.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "app": {"type": "string", "enum": ["netflix", "youtube"]},
                "query": {"type": "string", "maxLength": 100},
            },
            "required": ["app", "query"],
        },
        "annotations": {"title": "Search Netflix or YouTube", "readOnlyHint": False, "destructiveHint": False},
    },
    {
        "name": "tv_find",
        "description": "Look up videos without changing anything on the TV. 'youtube' returns the top YouTube results "
                       "(id, title, channel, length); 'jellyfin' searches your own Jellyfin library on your "
                       "homelab by title, then by genre (id, title, kind, year, genres). For Jellyfin, a general query "
                       "like 'movies', 'shows' or 'anything' lists what is in the library, newest first, and a genre "
                       "like 'comedy' or 'horror' lists those. Use it to pick the right one, then pass its id to tv_play.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "source": {"type": "string", "enum": ["youtube", "jellyfin"]},
                "query": {"type": "string", "maxLength": 100},
                "count": {"type": "integer", "minimum": 1, "maximum": 10, "default": 5},
            },
            "required": ["source", "query"],
        },
        "annotations": {"title": "Find videos", "readOnlyHint": True},
    },
    {
        "name": "tv_play",
        "description": "Start playing a video on the Fire TV, straight away. 'youtube' plays in SmartTube "
                       "(YouTube without ads); 'jellyfin' plays a movie or show from your Jellyfin server (a show "
                       "continues with its next episode). Give a query to play the best match, or an id from tv_find "
                       "to play exactly that one. For Netflix use tv_search instead: Netflix can only show results.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "source": {"type": "string", "enum": ["youtube", "jellyfin"]},
                "query": {"type": "string", "maxLength": 100, "description": "what to play, or an id from tv_find"},
            },
            "required": ["source", "query"],
        },
        "annotations": {"title": "Play a video", "readOnlyHint": False, "destructiveHint": False},
