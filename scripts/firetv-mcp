def firetv(*args):
    try:
        p = subprocess.run([FIRETV, *args], capture_output=True, text=True, timeout=45)
    except subprocess.TimeoutExpired:
        return False, "The TV took too long to answer."
    out = (p.stdout + p.stderr).strip().replace("firetv: ", "")
    return p.returncode == 0, out


def check(value, allowed):
    if value not in allowed:
        raise ValueError(f"'{value}' is not one of: {', '.join(allowed)}")
    return value


def count(args, key):
    n = int(args.get(key, 1))
    if not 1 <= n <= 10:
        raise ValueError(f"{key} must be between 1 and 10")
    return str(n)


def run_tool(name, args):
    if name == "tv_status":
        return firetv("status")
    if name == "tv_open_app":
        return firetv("open", check(args.get("app"), APPS))
    if name == "tv_press":
        button = check(args.get("button"), BUTTONS)
        times = count(args, "times")
        ok, out = firetv(button, times) if button in ("back", "up", "down", "left", "right") else firetv(button)
        return ok, out or f"Pressed {button}" + (f" {times} times" if times != "1" else "") + "."
    if name == "tv_volume":
        action = check(args.get("action"), ["up", "down", "mute"])
        if action == "mute":
            ok, out = firetv("mute")
        else:
            ok, out = firetv("vol" + action, count(args, "steps"))
        if ok:
            _, status = firetv("status")
            out = next((l.split(None, 1)[1] for l in status.splitlines() if l.startswith("volume")), "done")
            out = f"Volume is now {out}."
        return ok, out
    if name == "tv_search":
        query = str(args.get("query", "")).strip()[:100]
        if not query:
            raise ValueError("query is empty")
        app = check(args.get("app"), ["netflix", "youtube"])
        ok, out = firetv("search", app, query)
        return ok, f"Showing {app} results for \"{query}\" on the TV." if ok else out
    if name in ("tv_find", "tv_play"):
        query = str(args.get("query", "")).strip()[:100]
        if not query:
            raise ValueError("query is empty")
        source = check(args.get("source"), ["youtube", "jellyfin"])
        if name == "tv_play":
            ok, out = firetv("play", source, query)
            return ok, (out[0].upper() + out[1:] + " on the TV.") if ok and out else out
        ok, out = firetv("find", source, query, count(args, "count"))
        if not ok:
            return ok, out
        cols = ["id", "title", "channel", "length"] if source == "youtube" else ["id", "title", "kind", "year", "genres"]
        rows = [dict(zip(cols, l.split("\t"))) for l in out.splitlines() if "\t" in l]
        return True, json.dumps(rows, ensure_ascii=False)
    if name == "tv_settings":
        page = args.get("page")
        return firetv("settings", check(page, SETTINGS)) if page else firetv("settings")
    if name == "tv_type":
        text = str(args.get("text", ""))[:100]
        if not text:
            raise ValueError("text is empty")
        ok, out = firetv("text", text)
        return ok, out or f"Typed \"{text}\"."
    if name == "tv_input":
        return firetv("hdmi", check(args.get("input"), ["1", "2", "3", "av"]))
    if name == "tv_screen":
        action = check(args.get("action"), ["sleep", "wake"])
        ok, out = firetv(action)
        return ok, out or f"Screen {'off' if action == 'sleep' else 'on'}."
    raise ValueError(f"unknown tool {name}")


def reply(msg_id, result=None, error=None):
    msg = {"jsonrpc": "2.0", "id": msg_id}
    if error:
        msg["error"] = error
    else:
        msg["result"] = result
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            reply(None, error={"code": -32700, "message": "parse error"})
            continue
        method, msg_id = msg.get("method"), msg.get("id")
        if msg_id is None:  # notification
            continue
        params = msg.get("params") or {}
        if method == "initialize":
            reply(msg_id, {
                "protocolVersion": params.get("protocolVersion", "2025-06-18"),
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "firetv", "version": "1.0"},
            })
        elif method == "ping":
            reply(msg_id, {})
        elif method == "tools/list":
            reply(msg_id, {"tools": TOOLS})
        elif method == "tools/call":
            try:
                ok, out = run_tool(params.get("name"), params.get("arguments") or {})
            except (ValueError, TypeError) as e:
                ok, out = False, str(e)
            reply(msg_id, {"content": [{"type": "text", "text": out or "Done."}], "isError": not ok})
        else:
            reply(msg_id, error={"code": -32601, "message": f"unknown method {method}"})


if __name__ == "__main__":
    main()
