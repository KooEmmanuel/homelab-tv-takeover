            "properties": {"input": {"type": "string", "enum": ["1", "2", "3", "av"]}},
            "required": ["input"],
        },
        "annotations": {"title": "Switch input", "readOnlyHint": False, "destructiveHint": False},
    },
    {
        "name": "tv_screen",
        "description": "Turn the Fire TV screen off (sleep) or back on (wake). "
                       "Wake only works if the TV went to sleep recently and still answers.",
        "inputSchema": {
            "type": "object",
            "properties": {"action": {"type": "string", "enum": ["sleep", "wake"]}},
            "required": ["action"],
        },
        "annotations": {"title": "Screen on or off", "readOnlyHint": False, "destructiveHint": False},
    },
